generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

model Partner {
  id                     String           @id @default(cuid())
  name                   String
  email                  String?          @unique
  /// Global default equity % (among active partners must sum to 100 — enforced in app layer).
  defaultSharePercentage Float            @default(0)
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  // Relations
  projectPartners        ProjectPartner[]
  expensesPaid           ProjectExpense[] @relation("ExpensePaidBy")
  drawings               PartnerDrawing[]
  companyPayments        CompanyExpensePayment[]

  @@index([isActive])
  @@map("partners")
}

model Project {
  id              String           @id @default(cuid())
  name            String
  description     String?
  contractValue   Decimal          @db.Decimal(14, 2)
  status          ProjectStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // Relations — snapshot equity lives in ProjectPartner and NEVER mutates
  // when Partner.defaultSharePercentage changes.
  projectPartners ProjectPartner[]
  clientPayments  ClientPayment[]
  expenses        ProjectExpense[]

  @@index([status])
  @@map("projects")
}

/// Snapshot of a partner's equity for ONE project.
/// Copied from Partner.defaultSharePercentage at project creation,
/// then freely adjustable per project (must sum to 100 — enforced in app layer).
model ProjectPartner {
  id               String   @id @default(cuid())
  projectId        String
  partnerId        String
  sharePercentage  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([projectId, partnerId])
  @@index([projectId])
  @@index([partnerId])
  @@map("project_partners")
}

model ClientPayment {
  id             String   @id @default(cuid())
  projectId      String
  amount         Decimal  @db.Decimal(14, 2)
  milestoneLabel String?
  notes          String?
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([paidAt])
  @@map("client_payments")
}

model ProjectExpense {
  id               String    @id @default(cuid())
  projectId        String
  /// Null = cost covered directly by the client (informational only:
  /// excluded from firm totals, reimbursements and profit splits).
  paidByPartnerId  String?
  amount           Decimal   @db.Decimal(14, 2)
  description      String
  expenseDate      DateTime  @default(now())
  /// False = partner is still owed this money. True = firm has reimbursed them.
  isReimbursed     Boolean   @default(false)
  reimbursedAt     DateTime?
  createdAt        DateTime  @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paidBy      Partner? @relation("ExpensePaidBy", fields: [paidByPartnerId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([paidByPartnerId])
  @@index([isReimbursed])
  @@map("project_expenses")
}

model PartnerDrawing {
  id        String   @id @default(cuid())
  partnerId String
  amount    Decimal  @db.Decimal(14, 2)
  notes     String?
  drawnAt   DateTime @default(now())
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([drawnAt])
  @@map("partner_drawings")
}

enum CompanyExpenseKind {
  FIXED
  VARIABLE
}

/// Company overhead bill (rent, subscriptions…) shared by all ACTIVE
/// partners per their global default equity. Contributions are recorded
/// per partner; whoever pays MORE than their share is automatically
/// credited (overpayment → pending money owed back to them).
model CompanyExpense {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(14, 2)
  notes       String?
  expenseDate DateTime @default(now())
  kind        CompanyExpenseKind @default(VARIABLE)
  createdAt   DateTime @default(now())

  payments CompanyExpensePayment[]

  @@map("company_expenses")
}

model CompanyExpensePayment {
  id        String   @id @default(cuid())
  expenseId String
  partnerId String
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  expense CompanyExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@index([partnerId])
  @@map("company_expense_payments")
}

/// Fixed company cost registry (office rent, subscriptions…) defined ONCE.
/// Recording a payment picks one from a dropdown and snapshots its
/// title/amount into a CompanyExpense instance — later edits here never
/// rewrite recorded history.
model CompanyFixedCost {
  id        String   @id @default(cuid())
  title     String
  amount    Decimal  @db.Decimal(14, 2)
  notes     String?
  createdAt DateTime @default(now())

  @@map("company_fixed_costs")
}
