generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

model Partner {
  id                     String           @id @default(cuid())
  name                   String
  email                  String?          @unique
  /// Global default equity % (among active partners must sum to 100 — enforced in app layer).
  defaultSharePercentage Float            @default(0)
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  // Relations
  projectPartners        ProjectPartner[]
  expensesPaid           Expense[]        @relation("ExpensePaidBy")
  drawings               PartnerDrawing[]
  companyPayments        CompanyExpensePayment[]
  companyPayouts         CompanyPayout[]
  /// Client payments physically received into this partner's custody.
  custodyPayments        ClientPayment[]  @relation("PaymentsReceivedInCustody")

  @@index([isActive])
  @@map("partners")
}

model Project {
  id              String           @id @default(cuid())
  name            String
  description     String?
  contractValue   Decimal          @db.Decimal(14, 2)
  status          ProjectStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // Relations — snapshot equity lives in ProjectPartner and NEVER mutates
  // when Partner.defaultSharePercentage changes.
  projectPartners        ProjectPartner[]
  clientPayments         ClientPayment[]
  expenses               Expense[]

  @@index([status])
  @@map("projects")
}

/// Snapshot of a partner's equity for ONE project.
/// Copied from Partner.defaultSharePercentage at project creation,
/// then freely adjustable per project (must sum to 100 — enforced in app layer).
model ProjectPartner {
  id               String   @id @default(cuid())
  projectId        String
  partnerId        String
  sharePercentage  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([projectId, partnerId])
  @@index([projectId])
  @@index([partnerId])
  @@map("project_partners")
}

model ClientPayment {
  id             String   @id @default(cuid())
  projectId      String
  amount         Decimal  @db.Decimal(14, 2)
  milestoneLabel String?
  notes          String?
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  /// Partner who physically received the cash/transfer into custody.
  receivedByPartnerId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receivedBy Partner @relation("PaymentsReceivedInCustody", fields: [receivedByPartnerId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([paidAt])
  @@index([receivedByPartnerId])
  @@map("client_payments")
}

model Expense {
  id                String    @id @default(cuid())
  /// Null = Firm General Expense. Non-null = Project Direct Expense.
  projectId         String?
  /// Which partner paid the amount (stored in paidByPartnerId column in DB).
  paidById          String?   @map("paidByPartnerId")
  amount            Decimal   @db.Decimal(14, 2)
  description       String
  expenseDate       DateTime  @default(now())
  /// False = partner is still owed this money. True = firm has reimbursed them or deducted from project custody.
  isReimbursed      Boolean   @default(false)
  reimbursedAt      DateTime?
  /// True when this project expense was deducted directly from partner's project custody cash
  deductFromCustody Boolean   @default(false)
  createdAt         DateTime  @default(now())

  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paidBy      Partner? @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([paidById])
  @@index([isReimbursed])
  @@map("project_expenses")
}

model PartnerDrawing {
  id        String   @id @default(cuid())
  partnerId String
  amount    Decimal  @db.Decimal(14, 2)
  notes     String?
  drawnAt   DateTime @default(now())
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([drawnAt])
  @@map("partner_drawings")
}

enum CompanyExpenseKind {
  FIXED
  VARIABLE
}

/// Company overhead bill (rent, subscriptions…) shared by all ACTIVE
/// partners per their global default equity. Contributions are recorded
/// per partner; whoever pays MORE than their share is automatically
/// credited (overpayment → pending money owed back to them).
model CompanyExpense {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @db.Decimal(14, 2)
  notes       String?
  expenseDate DateTime @default(now())
  kind        CompanyExpenseKind @default(VARIABLE)
  createdAt   DateTime @default(now())

  payments CompanyExpensePayment[]
  payouts  CompanyPayout[]

  @@map("company_expenses")
}

/// Cash the FIRM paid back to a partner (settles their pending company
/// credit). The other direction — partner paying what they owe — is just a
/// CompanyExpensePayment. Payouts never touch bill collection math
/// (collected/remaining); they only reduce the partner's net credit.
model CompanyPayout {
  id        String   @id @default(cuid())
  partnerId String
  /// Bill being settled, if any (null = general firm→partner payout).
  expenseId String?
  amount    Decimal  @db.Decimal(14, 2)
  notes     String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  partner Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  expense CompanyExpense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([expenseId])
  @@map("company_payouts")
}

model CompanyExpensePayment {
  id        String   @id @default(cuid())
  expenseId String
  partnerId String
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  expense CompanyExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@index([partnerId])
  @@map("company_expense_payments")
}

/// Fixed company cost registry (office rent, subscriptions…) defined ONCE.
/// Recording a payment picks one from a dropdown and snapshots its
/// title/amount into a CompanyExpense instance — later edits here never
/// rewrite recorded history.
model CompanyFixedCost {
  id        String   @id @default(cuid())
  title     String
  amount    Decimal  @db.Decimal(14, 2)
  notes     String?
  createdAt DateTime @default(now())

  @@map("company_fixed_costs")
}

/// Login account for the auth layer (see src/lib/auth.ts).
/// The whole app sits behind the session gate in src/proxy.ts — no visitor
/// can read company data without a valid JWT session cookie.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
